{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "e2e": {
            "command": "npx",
            "args": [
                "e2e",
                "mcp"
            ]
        }
    }
}
